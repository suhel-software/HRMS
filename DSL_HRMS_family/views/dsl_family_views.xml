<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Standalone Family & Dependents Registry Views -->
    <record id="view_dsl_employee_family_list" model="ir.ui.view">
        <field name="name">dsl.employee.family.list</field>
        <field name="model">dsl.employee.family</field>
        <field name="arch" type="xml">
            <list string="Employee Family &amp; Dependents Registry">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="name" decoration-bf="1"/>
                <field name="name_bn" optional="show"/>
                <field name="relationship" widget="badge"/>
                <field name="date_of_birth"/>
                <field name="age_years"/>
                <field name="blood_group" optional="show"/>
                <field name="is_dependent" widget="boolean_toggle"/>
                <field name="is_medical_insured" widget="boolean_toggle"/>
                <field name="insurance_card_no" optional="show"/>
                <field name="phone" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_employee_family_form" model="ir.ui.view">
        <field name="name">dsl.employee.family.form</field>
        <field name="model">dsl.employee.family</field>
        <field name="arch" type="xml">
            <form string="Family Member / Dependent">
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Family Member Full Name"/>
                        </h1>
                        <h3>
                            <field name="name_bn" placeholder="সদস্যের নাম (বাংলায়)"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Employee &amp; Relationship">
                            <field name="employee_id"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="relationship"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="age_years"/>
                            <field name="blood_group"/>
                        </group>
                        <group string="Identity, Medical Insurance &amp; Contact">
                            <field name="nid_or_birth_reg"/>
                            <field name="occupation"/>
                            <field name="phone"/>
                            <field name="is_dependent"/>
                            <field name="is_medical_insured"/>
                            <field name="insurance_card_no" invisible="not is_medical_insured"/>
                            <field name="is_emergency_contact"/>
                        </group>
                    </group>
                    <group string="Welfare / Medical Remarks">
                        <field name="notes" nolabel="1" placeholder="Optional medical, daycare, or scholarship notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsl_employee_family_search" model="ir.ui.view">
        <field name="name">dsl.employee.family.search</field>
        <field name="model">dsl.employee.family</field>
        <field name="arch" type="xml">
            <search string="Search Family &amp; Dependents">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="insurance_card_no"/>
                <filter name="dependents_only" string="Dependents" domain="[('is_dependent', '=', True)]"/>
                <filter name="medical_insured" string="Group Health Insured" domain="[('is_medical_insured', '=', True)]"/>
                <searchpanel>
                    <field name="company_id" groups="base.group_multi_company" icon="fa-building" enable_counters="1"/>
                    <field name="branch_id" icon="fa-map-marker" enable_counters="1"/>
                    <field name="relationship" icon="fa-heart" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- 2. Employee Form Tab & Smart Button -->
    <record id="view_employee_form_inherit_dsl_family" model="ir.ui.view">
        <field name="name">hr.employee.form.dsl.family</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="DSL_HRMS_employee.view_employee_form_inherit_dsl_dossier"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_family_members"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                        groups="hr.group_hr_user">
                    <field name="family_member_count" widget="statinfo" string="Family"/>
                </button>
            </xpath>
            <xpath expr="//separator[@name='dsl_nominee_section_sep']" position="before">
                <separator string="Family Members &amp; Medical Insurance Dependents (DSL_HRMS_family)"/>
                <field name="family_member_ids" context="{'default_employee_id': id}">
                    <list editable="bottom">
                        <field name="name" decoration-bf="1"/>
                        <field name="name_bn" optional="show"/>
                        <field name="relationship"/>
                        <field name="gender" optional="show"/>
                        <field name="date_of_birth"/>
                        <field name="age_years"/>
                        <field name="blood_group" optional="show"/>
                        <field name="phone"/>
                        <field name="is_dependent" widget="boolean_toggle"/>
                        <field name="is_medical_insured" widget="boolean_toggle"/>
                        <field name="insurance_card_no" optional="show"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- 3. Action & Menu under Workforce -->
    <record id="action_dsl_employee_family" model="ir.actions.act_window">
        <field name="name">Family &amp; Medical Dependents Registry</field>
        <field name="res_model">dsl.employee.family</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dsl_employee_family"
              name="Family &amp; Dependents"
              parent="DSL_HRMS_core.menu_dsl_hrms_workforce"
              action="action_dsl_employee_family"
              groups="DSL_HRMS_core.group_dsl_hrms_officer"
              sequence="50"/>
</odoo>

