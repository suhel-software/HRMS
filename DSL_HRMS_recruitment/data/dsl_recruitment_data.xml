<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dsl_manpower_requisition" model="ir.sequence">
            <field name="name">Manpower Requisition</field>
            <field name="code">dsl.manpower.requisition</field>
            <field name="prefix">MPR-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dsl_job_applicant" model="ir.sequence">
            <field name="name">Job Applicant</field>
            <field name="code">dsl.job.applicant</field>
            <field name="prefix">APP-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

