<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_dsl_offer_letter" model="ir.actions.report">
        <field name="name">Employment Offer Letter</field>
        <field name="model">dsl.job.applicant</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">DSL_HRMS_recruitment.report_dsl_offer_letter_doc</field>
        <field name="report_file">DSL_HRMS_recruitment.report_dsl_offer_letter_doc</field>
        <field name="print_report_name">'Offer_Letter_%s' % (object.candidate_name)</field>
        <field name="binding_model_id" ref="model_dsl_job_applicant"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_dsl_offer_letter_doc">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 14px; line-height: 1.7;">
                        <div class="d-flex justify-content-between mb-4">
                            <div><strong>Ref:</strong> <span t-field="o.name"/></div>
                            <div><strong>Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/></div>
                        </div>
                        <p>
                            To,<br/>
                            <strong><span t-field="o.candidate_name"/></strong><br/>
                            Mobile: <span t-field="o.mobile"/>
                        </p>
                        <h4 class="fw-bold text-center text-uppercase my-4" style="text-decoration: underline;">
                            Offer of Employment — <span t-field="o.job_id.name"/>
                        </h4>
                        <p>Dear <span t-field="o.candidate_name"/>,</p>
                        <p>
                            Following our evaluation process, we are pleased to offer you the position of
                            <strong><span t-field="o.job_id.name"/></strong> in the
                            <strong><span t-field="o.department_id.name"/></strong> Department at
                            <strong><span t-field="o.company_id.name"/></strong>.
                        </p>
                        <ul>
                            <li><strong>Monthly Gross Compensation:</strong> <span t-field="o.offered_gross"/> (subject to company salary structure &amp; NBR TDS rules)</li>
                            <li><strong>Expected Date of Joining:</strong> <span t-field="o.proposed_joining_date"/></li>
                            <li><strong>Probation Period:</strong> Standard probation as per Bangladesh Labour Act 2006</li>
                        </ul>
                        <p class="mt-4">
                            Kindly sign and return a copy of this Offer Letter as confirmation of your acceptance.
                        </p>
                        <div class="row mt-5 pt-4">
                            <div class="col-6">___________________________<br/>Head of Human Resources</div>
                            <div class="col-6 text-end">___________________________<br/>Candidate Acceptance Signature</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

