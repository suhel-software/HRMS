<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_crossovered_budget" model="ir.sequence">
            <field name="name">Financial Budget Reference</field>
            <field name="code">crossovered.budget</field>
            <field name="prefix">DSL/BDG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_job_create" model="ir.sequence">
            <field name="name">Budget Job / Project Code</field>
            <field name="code">job.create</field>
            <field name="prefix">DSL/JOB/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_job_summary" model="ir.sequence">
            <field name="name">Cost Center Job Budget</field>
            <field name="code">job.summary</field>
            <field name="prefix">DSL/JBDG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_work_order" model="ir.sequence">
            <field name="name">Budget Work Order</field>
            <field name="code">work.order</field>
            <field name="prefix">DSL/WO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_cost_advance" model="ir.sequence">
            <field name="name">Budget Cost Advance</field>
            <field name="code">cost.advance</field>
            <field name="prefix">DSL/ADV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_bill_adjustment" model="ir.sequence">
            <field name="name">Bill &amp; Budget Adjustment</field>
            <field name="code">bill.adjustment</field>
            <field name="prefix">DSL/BADJ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

