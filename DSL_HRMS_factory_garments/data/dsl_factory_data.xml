<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dsl_factory_line_roster" model="ir.sequence">
            <field name="name">Factory Floor Line Sheet</field>
            <field name="code">dsl.factory.line.roster</field>
            <field name="prefix">FLR-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dsl_factory_compliance_audit" model="ir.sequence">
            <field name="name">Factory Compliance Audit</field>
            <field name="code">dsl.factory.compliance.audit</field>
            <field name="prefix">AUD-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

