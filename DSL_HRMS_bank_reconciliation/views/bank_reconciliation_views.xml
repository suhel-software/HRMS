<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client Action for Interactive Bank Reconciliation Console -->
    <record id="action_dsl_bank_reconciliation" model="ir.actions.client">
        <field name="name">Bank Reconciliation</field>
        <field name="tag">DSL_HRMS_bank_reconciliation.Console</field>
    </record>

    <!-- Menu Item under Accounting -->
    <menuitem id="menu_dsl_bank_reconciliation"
              name="Bank Reconciliation"
              parent="account.menu_finance_entries"
              action="action_dsl_bank_reconciliation"
              sequence="15"/>

    <!-- Also under Customers menu for convenient access -->
    <menuitem id="menu_dsl_brs_bank_reconciliation_customer"
              name="Bank Reconciliation"
              parent="account.menu_finance_receivables"
              action="action_dsl_bank_reconciliation"
              sequence="30"/>

    <!-- Also under Vendors menu for convenient access -->
    <menuitem id="menu_dsl_brs_bank_reconciliation_vendor"
              name="Bank Reconciliation"
              parent="account.menu_finance_payables"
              action="action_dsl_bank_reconciliation"
              sequence="30"/>

    <!-- Journal Form View Inheritance: Show in Bank Reconciliation Toggle -->
    <record id="view_account_journal_form_inherit_dsl_brs_bank_rec" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.dsl.bank.reconciliation</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="show_in_bank_reconciliation" string="Show in Bank Reconciliation" widget="boolean_toggle" invisible="type not in ('bank', 'cash')"/>
            </xpath>
        </field>
    </record>

    <!-- Journal Tree View Inheritance: Show in Bank Reconciliation Toggle -->
    <record id="view_account_journal_tree_inherit_dsl_brs_bank_rec" model="ir.ui.view">
        <field name="name">account.journal.tree.inherit.dsl.bank.reconciliation</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="show_in_bank_reconciliation" string="Show in Bank Reconciliation" widget="boolean_toggle" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Journal Items (Move Line) Tree View: Show Bank Clearance Date -->
    <record id="view_move_line_tree_inherit_dsl_brs_bank_rec" model="ir.ui.view">
        <field name="name">account.move.line.tree.inherit.dsl.bank.rec</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="bank_date" string="Bank Clearance Date" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
