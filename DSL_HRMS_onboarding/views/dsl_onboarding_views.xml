<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsl_employee_onboarding_list" model="ir.ui.view">
        <field name="name">dsl.employee.onboarding.list</field>
        <field name="model">dsl.employee.onboarding</field>
        <field name="arch" type="xml">
            <list string="New Joiner Onboarding Plans" decoration-success="state == 'completed'">
                <field name="name" decoration-bf="1"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="joining_date"/>
                <field name="buddy_employee_id" optional="show"/>
                <field name="completion_pct" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_progress'"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_employee_onboarding_form" model="ir.ui.view">
        <field name="name">dsl.employee.onboarding.form</field>
        <field name="model">dsl.employee.onboarding</field>
        <field name="arch" type="xml">
            <form string="Employee Onboarding &amp; Asset Handover">
                <header>
                    <button name="action_start" string="Start Onboarding" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete_all" string="Mark 100% Inducted" type="object"
                            class="btn-success" invisible="state == 'completed'"
                            groups="DSL_HRMS_core.group_dsl_hrms_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Onboarding Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="New Joiner &amp; Role">
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                        </group>
                        <group string="Induction &amp; Progress">
                            <field name="joining_date"/>
                            <field name="buddy_employee_id"/>
                            <field name="completion_pct" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="1. 5-Wing Onboarding Checklist" name="checklist">
                            <field name="task_ids">
                                <list editable="bottom" decoration-success="is_done">
                                    <field name="category"/>
                                    <field name="task_title"/>
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                    <field name="is_done" widget="boolean_toggle"/>
                                    <field name="completed_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="2. IT &amp; Admin Asset Handover" name="assets">
                            <field name="asset_ids" context="{'default_employee_id': employee_id, 'default_company_id': company_id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="asset_name"/>
                                    <field name="asset_category"/>
                                    <field name="employee_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="asset_value"/>
                                    <field name="issue_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dsl_employee_onboarding" model="ir.actions.act_window">
        <field name="name">Onboarding &amp; Asset Handover</field>
        <field name="res_model">dsl.employee.onboarding</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Standalone Asset Custody Register -->
    <record id="view_dsl_employee_asset_list" model="ir.ui.view">
        <field name="name">dsl.employee.asset.assignment.list</field>
        <field name="model">dsl.employee.asset.assignment</field>
        <field name="arch" type="xml">
            <list string="Employee Asset Custody Register">
                <field name="name" decoration-bf="1"/>
                <field name="asset_name"/>
                <field name="asset_category" widget="badge"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="issue_date"/>
                <field name="asset_value"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'returned'" decoration-info="state == 'assigned'"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_employee_asset_form" model="ir.ui.view">
        <field name="name">dsl.employee.asset.assignment.form</field>
        <field name="model">dsl.employee.asset.assignment</field>
        <field name="arch" type="xml">
            <form string="Employee Asset Handover">
                <header>
                    <button name="action_mark_returned" string="Mark Returned" type="object"
                            class="btn-success" invisible="state != 'assigned'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Asset Details">
                            <field name="name"/>
                            <field name="asset_name"/>
                            <field name="asset_category"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="asset_value"/>
                        </group>
                        <group string="Custodian &amp; Dates">
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="issue_date"/>
                            <field name="return_date" invisible="not return_date"/>
                        </group>
                    </group>
                    <field name="remarks" placeholder="Charger, bag, IMEI / MAC address &amp; condition notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dsl_employee_asset" model="ir.actions.act_window">
        <field name="name">Employee Asset Custody</field>
        <field name="res_model">dsl.employee.asset.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Populate Tab 12 "Assets" on Employee Profile -->
    <record id="view_employee_form_inherit_dsl_assets" model="ir.ui.view">
        <field name="name">hr.employee.form.dsl.assets</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="DSL_HRMS_employee.view_employee_form_inherit_dsl_dossier"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='dsl_tab_12_assets']" position="inside">
                <separator string="Laptop, Desktop, Mobile, ID Card &amp; Equipment Custody (DSL_HRMS_employee_asset)"/>
                <field name="dsl_asset_assignment_ids" context="{'default_employee_id': id}">
                    <list editable="bottom" decoration-success="state == 'returned'" decoration-info="state == 'assigned'">
                        <field name="name" decoration-bf="1"/>
                        <field name="asset_name" decoration-bf="1"/>
                        <field name="asset_category" widget="badge"/>
                        <field name="issue_date"/>
                        <field name="return_date"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="asset_value"/>
                        <field name="remarks"/>
                        <field name="state" widget="badge"
                               decoration-info="state == 'assigned'"
                               decoration-success="state == 'returned'"
                               decoration-danger="state == 'damaged_lost'"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_dsl_employee_onboarding"
              name="Onboarding &amp; Checklist"
              parent="DSL_HRMS_core.menu_dsl_hrms_talent_root"
              action="action_dsl_employee_onboarding"
              sequence="30"/>

    <menuitem id="menu_dsl_employee_asset"
              name="Employee Asset Register"
              parent="DSL_HRMS_core.menu_dsl_hrms_talent_root"
              action="action_dsl_employee_asset"
              sequence="35"/>
</odoo>

