<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Standalone Academic Qualification Views (HR Registry) -->
    <record id="view_dsl_employee_education_list" model="ir.ui.view">
        <field name="name">dsl.employee.education.list</field>
        <field name="model">dsl.employee.education</field>
        <field name="arch" type="xml">
            <list string="Employee Academic Qualifications">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="degree_level" widget="badge"
                       decoration-primary="degree_level in ('phd', 'master', 'professional')"
                       decoration-info="degree_level in ('bachelor', 'diploma')"
                       decoration-muted="degree_level in ('hsc', 'ssc', 'psc_jsc')"/>
                <field name="degree_title" decoration-bf="1"/>
                <field name="major_group"/>
                <field name="institute_name"/>
                <field name="result_display"/>
                <field name="passing_year"/>
                <field name="is_highest_degree" widget="boolean_toggle" optional="show"/>
                <field name="verification_status" widget="badge"
                       decoration-success="verification_status == 'verified'"
                       decoration-warning="verification_status == 'pending'"
                       decoration-danger="verification_status == 'discrepancy'"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_employee_education_form" model="ir.ui.view">
        <field name="name">dsl.employee.education.form</field>
        <field name="model">dsl.employee.education</field>
        <field name="arch" type="xml">
            <form string="Academic Qualification">
                <header>
                    <field name="verification_status" widget="statusbar" clickable="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee &amp; Degree">
                            <field name="employee_id"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="degree_level"/>
                            <field name="degree_title" placeholder="e.g. B.Sc. in Computer Science &amp; Engineering"/>
                            <field name="major_group" placeholder="e.g. CSE / Finance / Science"/>
                            <field name="is_highest_degree"/>
                        </group>
                        <group string="Institution &amp; Academic Result">
                            <field name="institute_name" placeholder="e.g. BUET / University of Dhaka"/>
                            <field name="board_or_university" placeholder="e.g. Dhaka Board / UGC"/>
                            <field name="result_type"/>
                            <field name="cgpa_score" invisible="result_type not in ('cgpa_4', 'gpa_5')"/>
                            <field name="division_class" invisible="result_type != 'division'"/>
                            <field name="passing_year" placeholder="e.g. 2020"/>
                            <field name="duration_years" placeholder="e.g. 4 Years"/>
                            <field name="certificate_filename" invisible="1"/>
                            <field name="certificate_file" filename="certificate_filename"/>
                        </group>
                    </group>
                    <group string="HR Verification Remarks">
                        <field name="notes" nolabel="1" placeholder="Certificate verification notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsl_employee_education_search" model="ir.ui.view">
        <field name="name">dsl.employee.education.search</field>
        <field name="model">dsl.employee.education</field>
        <field name="arch" type="xml">
            <search string="Search Qualifications">
                <field name="employee_id"/>
                <field name="degree_title"/>
                <field name="institute_name"/>
                <field name="major_group"/>
                <filter name="highest_only" string="Highest Degree Only" domain="[('is_highest_degree', '=', True)]"/>
                <filter name="verified" string="Verified" domain="[('verification_status', '=', 'verified')]"/>
                <filter name="pending" string="Pending Verification" domain="[('verification_status', '=', 'pending')]"/>
                <searchpanel>
                    <field name="company_id" groups="base.group_multi_company" icon="fa-building" enable_counters="1"/>
                    <field name="branch_id" icon="fa-map-marker" enable_counters="1"/>
                    <field name="degree_level" icon="fa-graduation-cap" enable_counters="1"/>
                    <field name="verification_status" icon="fa-check-square-o" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- 2. Employee Form Tab & Smart Button -->
    <record id="view_employee_form_inherit_dsl_education" model="ir.ui.view">
        <field name="name">hr.employee.form.dsl.education</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="DSL_HRMS_employee.view_employee_form_inherit_dsl_dossier"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_education_records"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-graduation-cap"
                        groups="hr.group_hr_user">
                    <field name="education_count" widget="statinfo" string="Degrees"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='dsl_education_tab']" position="inside">
                <separator string="Academic Qualifications (SSC / HSC / Bachelor / Masters)"/>
                <field name="education_ids" context="{'default_employee_id': id}">
                    <list>
                        <field name="degree_level" widget="badge"
                               decoration-primary="degree_level in ('phd', 'master', 'professional')"
                               decoration-info="degree_level in ('bachelor', 'diploma')"/>
                        <field name="degree_title" decoration-bf="1"/>
                        <field name="major_group"/>
                        <field name="institute_name"/>
                        <field name="result_display"/>
                        <field name="passing_year"/>
                        <field name="is_highest_degree" widget="boolean_toggle"/>
                        <field name="verification_status" widget="badge"
                               decoration-success="verification_status == 'verified'"
                               decoration-warning="verification_status == 'pending'"
                               decoration-danger="verification_status == 'discrepancy'"/>
                    </list>
                </field>
                <separator string="Professional Certifications, Licenses &amp; Specialized Training"/>
                <field name="certification_ids" context="{'default_employee_id': id}">
                    <list editable="bottom">
                        <field name="name" decoration-bf="1"/>
                        <field name="issuing_authority"/>
                        <field name="credential_id"/>
                        <field name="issue_date"/>
                        <field name="expiry_date"/>
                        <field name="cert_status" widget="badge"
                               decoration-success="cert_status == 'active'"
                               decoration-danger="cert_status == 'expired'"/>
                        <field name="attachment_filename" column_invisible="True"/>
                        <field name="attachment_file" filename="attachment_filename" widget="binary"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <!-- 3. Action & Menu under Workforce -->
    <record id="action_dsl_employee_education" model="ir.actions.act_window">
        <field name="name">Academic Qualifications Registry</field>
        <field name="res_model">dsl.employee.education</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dsl_employee_education"
              name="Qualifications"
              parent="DSL_HRMS_core.menu_dsl_hrms_workforce"
              action="action_dsl_employee_education"
              groups="DSL_HRMS_core.group_dsl_hrms_officer"
              sequence="40"/>
</odoo>

