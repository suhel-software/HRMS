<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dsl_overtime_request" model="ir.sequence">
            <field name="name">DSL Statutory Overtime</field>
            <field name="code">dsl.overtime.request</field>
            <field name="prefix">OT-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="policy_dsl_bd_labour_act_sec108" model="dsl.overtime.policy">
            <field name="sequence">10</field>
            <field name="name">Bangladesh Labour Act 2006 (Sec 108 — 2.0x Basic / 208h)</field>
            <field name="code">BD-LA-2X</field>
            <field name="company_id" eval="False"/>
            <field name="branch_id" eval="False"/>
            <field name="monthly_hours_divisor">208.0</field>
            <field name="weekday_multiplier">2.0</field>
            <field name="holiday_multiplier">2.0</field>
            <field name="min_ot_minutes">30</field>
            <field name="statutory_daily_cap_hours">2.0</field>
            <field name="statutory_weekly_cap_hours">12.0</field>
            <field name="notes">Statutory Double Basic Overtime per Section 108 of Bangladesh Labour Act 2006 &amp; Rule 102 of Bangladesh Labour Rules 2015: Hourly OT Rate = (Monthly Basic / 208) × 2.0.</field>
        </record>
    </data>
</odoo>

