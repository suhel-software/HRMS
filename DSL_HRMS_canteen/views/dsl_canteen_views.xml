<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsl_canteen_meal_log_list" model="ir.ui.view">
        <field name="name">dsl.canteen.meal.log.list</field>
        <field name="model">dsl.canteen.meal.log</field>
        <field name="arch" type="xml">
            <list string="Canteen Meal Booking &amp; Payroll Recovery" decoration-success="state == 'settled'">
                <field name="name" decoration-bf="1"/>
                <field name="meal_date"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="meal_item_id"/>
                <field name="meal_count" sum="Total Meals"/>
                <field name="employer_subsidy_total" sum="Total Subsidy"/>
                <field name="employee_deduction_total" sum="Total Employee Share" decoration-bf="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'booked'" decoration-success="state == 'settled'"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_canteen_meal_log_form" model="ir.ui.view">
        <field name="name">dsl.canteen.meal.log.form</field>
        <field name="model">dsl.canteen.meal.log</field>
        <field name="arch" type="xml">
            <form string="Canteen Meal Booking &amp; Subsidy Split">
                <header>
                    <button name="action_cancel" string="Cancel Token" type="object"
                            invisible="state != 'booked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="booked,settled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Canteen Token Ref."/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Employee &amp; Meal Package">
                            <field name="employee_id" readonly="state == 'settled'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="meal_item_id" readonly="state == 'settled'"/>
                            <field name="meal_date" readonly="state == 'settled'"/>
                            <field name="meal_count" readonly="state == 'settled'"/>
                        </group>
                        <group string="Subsidy vs. Monthly Payroll Deduction">
                            <field name="currency_id" invisible="1"/>
                            <field name="employer_subsidy_total"/>
                            <field name="employee_deduction_total" decoration-bf="1"/>
                            <field name="is_deducted"/>
                            <field name="payslip_id" invisible="not payslip_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dsl_canteen_meal_log" model="ir.actions.act_window">
        <field name="name">Canteen Meal Bookings</field>
        <field name="res_model">dsl.canteen.meal.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dsl_canteen_meal_item_form" model="ir.ui.view">
        <field name="name">dsl.canteen.meal.item.form</field>
        <field name="model">dsl.canteen.meal.item</field>
        <field name="arch" type="xml">
            <form string="Canteen Meal Package">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="meal_slot"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="unit_cost"/>
                            <field name="company_subsidy"/>
                            <field name="employee_payable" decoration-bf="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dsl_canteen_meal_item" model="ir.actions.act_window">
        <field name="name">Canteen Meal Packages</field>
        <field name="res_model">dsl.canteen.meal.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dsl_canteen_meal_log"
              name="Canteen &amp; Meal Recovery"
              parent="DSL_HRMS_core.menu_dsl_hrms_operations_root"
              action="action_dsl_canteen_meal_log"
              sequence="10"/>

    <menuitem id="menu_dsl_canteen_meal_item"
              name="Canteen Meal Packages"
              parent="DSL_HRMS_core.menu_dsl_hrms_configuration_root"
              action="action_dsl_canteen_meal_item"
              sequence="80"/>
</odoo>

