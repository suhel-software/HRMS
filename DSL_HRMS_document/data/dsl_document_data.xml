<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence -->
        <record id="seq_dsl_employee_document" model="ir.sequence">
            <field name="name">DSL Employee Document Sequence</field>
            <field name="code">dsl.employee.document</field>
            <field name="prefix">DOC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Pre-seeded Bangladesh HR Document Types -->
        <record id="doctype_smart_nid" model="dsl.document.type">
            <field name="name">National ID (Smart NID)</field>
            <field name="code">NID</field>
            <field name="category">identity</field>
            <field name="is_mandatory">True</field>
            <field name="requires_expiry">False</field>
            <field name="sequence">10</field>
        </record>
        <record id="doctype_passport" model="dsl.document.type">
            <field name="name">Passport (e-Passport / MRP)</field>
            <field name="code">PASSPORT</field>
            <field name="category">identity</field>
            <field name="requires_expiry">True</field>
            <field name="alert_days_before">90</field>
            <field name="sequence">20</field>
        </record>
        <record id="doctype_tin_cert" model="dsl.document.type">
            <field name="name">NBR e-TIN &amp; Tax Return Acknowledgement</field>
            <field name="code">TIN</field>
            <field name="category">statutory</field>
            <field name="is_mandatory">True</field>
            <field name="requires_expiry">True</field>
            <field name="alert_days_before">30</field>
            <field name="sequence">30</field>
        </record>
        <record id="doctype_appointment" model="dsl.document.type">
            <field name="name">Appointment Letter &amp; Employment Contract</field>
            <field name="code">APPT</field>
            <field name="category">employment</field>
            <field name="is_mandatory">True</field>
            <field name="requires_expiry">False</field>
            <field name="sequence">40</field>
        </record>
        <record id="doctype_confirmation" model="dsl.document.type">
            <field name="name">Confirmation / Increment Letter</field>
            <field name="code">CONF</field>
            <field name="category">employment</field>
            <field name="requires_expiry">False</field>
            <field name="sequence">50</field>
        </record>
        <record id="doctype_nda" model="dsl.document.type">
            <field name="name">Non-Disclosure &amp; Code of Conduct (NDA)</field>
            <field name="code">NDA</field>
            <field name="category">compliance</field>
            <field name="is_mandatory">True</field>
            <field name="sequence">60</field>
        </record>
        <record id="doctype_police_verif" model="dsl.document.type">
            <field name="name">Police Verification / Background Clearance</field>
            <field name="code">PVR</field>
            <field name="category">compliance</field>
            <field name="sequence">70</field>
        </record>
        <record id="doctype_medical_fit" model="dsl.document.type">
            <field name="name">Medical Fitness Certificate (Factory / Labour Act)</field>
            <field name="code">MED</field>
            <field name="category">compliance</field>
            <field name="requires_expiry">True</field>
            <field name="alert_days_before">30</field>
            <field name="sequence">80</field>
        </record>
        <record id="doctype_work_permit" model="dsl.document.type">
            <field name="name">BIDA Work Permit / Visa</field>
            <field name="code">VISA</field>
            <field name="category">statutory</field>
            <field name="requires_expiry">True</field>
            <field name="alert_days_before">60</field>
            <field name="sequence">90</field>
        </record>
        <record id="doctype_driving_lic" model="dsl.document.type">
            <field name="name">BRTA Driving License</field>
            <field name="code">BRTA</field>
            <field name="category">identity</field>
            <field name="requires_expiry">True</field>
            <field name="alert_days_before">45</field>
            <field name="sequence">100</field>
        </record>

        <!-- Daily Scheduled Cron for Document Expiry Alerts -->
        <record id="ir_cron_dsl_document_expiry_alert" model="ir.cron">
            <field name="name">DSL HRMS: Daily Employee Document Expiry Check &amp; Alerts</field>
            <field name="model_id" ref="model_dsl_employee_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_document_expiry_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">5</field>
        </record>
    </data>
</odoo>

