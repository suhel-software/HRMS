<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dsl_vehicle_requisition" model="ir.sequence">
            <field name="name">Vehicle Requisition</field>
            <field name="code">dsl.vehicle.requisition</field>
            <field name="prefix">VEH-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dsl_vehicle_fuel_log" model="ir.sequence">
            <field name="name">Vehicle Fuel Log</field>
            <field name="code">dsl.vehicle.fuel.log</field>
            <field name="prefix">FUEL-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="demo_vehicle_hq_microbus" model="dsl.hr.vehicle">
            <field name="name">Dhaka Metro-Cha-56-4410</field>
            <field name="vehicle_model">Toyota HiAce GL Pool Microbus</field>
            <field name="vehicle_type">microbus</field>
            <field name="odometer_km">28450.0</field>
        </record>
    </data>
</odoo>

