<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_dsl_fixed_asset" model="ir.sequence">
            <field name="name">Fixed Asset Code</field>
            <field name="code">dsl.fixed.asset</field>
            <field name="prefix">FA/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dsl_asset_assignment" model="ir.sequence">
            <field name="name">Asset Custody / Handover</field>
            <field name="code">dsl.asset.assignment</field>
            <field name="prefix">AHO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dsl_asset_transfer" model="ir.sequence">
            <field name="name">Asset Transfer</field>
            <field name="code">dsl.asset.transfer</field>
            <field name="prefix">ATR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dsl_asset_maintenance" model="ir.sequence">
            <field name="name">Asset Maintenance</field>
            <field name="code">dsl.asset.maintenance</field>
            <field name="prefix">AMT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_dsl_asset_verification" model="ir.sequence">
            <field name="name">Asset Physical Verification</field>
            <field name="code">dsl.asset.verification</field>
            <field name="prefix">AUD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

