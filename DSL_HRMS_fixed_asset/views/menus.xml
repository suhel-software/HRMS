    <menuitem id="menu_dsl_fa_operations" name="Operations" parent="menu_dsl_fixed_asset_root" sequence="20"/>
    <menuitem id="menu_dsl_fa_assignment" name="Custody &amp; Handover" parent="menu_dsl_fa_operations"
