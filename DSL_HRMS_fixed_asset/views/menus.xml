        <field name="name">Asset Groups</field>
        <field name="res_model">account.asset.group</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_dsl_fa_groups" name="Asset Groups" parent="menu_dsl_fa_config"
              action="action_dsl_asset_group" sequence="2"/>
    <menuitem id="menu_dsl_fa_locations" name="Locations" parent="menu_dsl_fa_config"
              action="action_dsl_asset_location" sequence="3"/>
