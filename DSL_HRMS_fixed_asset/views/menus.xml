<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone "Fixed Assets" application -->
    <menuitem id="menu_dsl_fixed_asset_root"
              name="Fixed Assets"
              web_icon="DSL_HRMS_fixed_asset,static/description/icon.png"
              groups="DSL_HRMS_fixed_asset.group_fixed_asset_user"
              sequence="42"/>

    <menuitem id="menu_dsl_fa_dashboard" name="Dashboard" parent="menu_dsl_fixed_asset_root"
              action="action_dsl_fixed_asset_dashboard" sequence="1"/>

    <menuitem id="menu_dsl_fa_assets" name="Assets" parent="menu_dsl_fixed_asset_root" sequence="10"/>
    <menuitem id="menu_dsl_fa_register" name="Asset Register" parent="menu_dsl_fa_assets"
              action="action_dsl_fixed_asset_register" sequence="1"/>
    <menuitem id="menu_dsl_fa_disposed" name="Disposed &amp; Sold" parent="menu_dsl_fa_assets"
