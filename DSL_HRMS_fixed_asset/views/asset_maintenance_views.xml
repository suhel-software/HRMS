<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsl_asset_maintenance_list" model="ir.ui.view">
        <field name="name">dsl.asset.maintenance.list</field>
        <field name="model">dsl.asset.maintenance</field>
        <field name="arch" type="xml">
            <list string="Asset Maintenance" decoration-danger="is_overdue" decoration-muted="state == 'cancel'">
                <field name="is_overdue" column_invisible="True"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="title"/>
                <field name="asset_id"/>
                <field name="maintenance_type" widget="badge"/>
                <field name="scheduled_date"/>
                <field name="completion_date" optional="show"/>
                <field name="vendor_id" optional="show"/>
                <field name="technician_id" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="cost" sum="Total Cost" widget="monetary"/>
                <field name="under_warranty" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'scheduled'"
                       decoration-warning="state == 'in_progress'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_asset_maintenance_form" model="ir.ui.view">
        <field name="name">dsl.asset.maintenance.form</field>
        <field name="model">dsl.asset.maintenance</field>
        <field name="arch" type="xml">
            <form string="Asset Maintenance">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Work" type="object" class="oe_highlight" invisible="state not in ('draft', 'scheduled')"/>
                    <button name="action_done" string="Mark Completed" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_create_vendor_bill" string="Create Vendor Bill" type="object" icon="fa-file-text-o"
                            invisible="state != 'done' or vendor_bill_id or cost == 0"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_vendor_bill" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not vendor_bill_id">
                            <div class="o_stat_info"><span class="o_stat_text">Vendor Bill</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Warranty" bg_color="text-bg-success" invisible="is_overdue or not under_warranty"/>
                    <field name="is_overdue" invisible="1"/>
                    <field name="vendor_bill_id" invisible="1"/>
                    <div class="oe_title">
                        <span class="o_form_label"><field name="name" readonly="1"/></span>
                        <h1><field name="title" placeholder="e.g. Quarterly servicing of generator"/></h1>
                        <field name="priority" widget="priority"/>
                    </div>
                    <group>
                        <group string="Asset">
                            <field name="asset_id" options="{'no_create': True}" readonly="state == 'done'"/>
                            <field name="asset_code"/>
                            <field name="asset_location_id"/>
                            <field name="maintenance_type" readonly="state == 'done'"/>
                            <field name="under_warranty"/>
                        </group>
                        <group string="Schedule &amp; Team">
                            <field name="scheduled_date" readonly="state == 'done'"/>
                            <field name="start_date"/>
                            <field name="completion_date"/>
                            <field name="downtime_hours" widget="float_time"/>
                            <field name="vendor_id"/>
                            <field name="technician_id"/>
                            <field name="responsible_user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work Details" name="work">
                            <group>
                                <field name="description" nolabel="1" colspan="2" placeholder="Describe the problem or planned work..."/>
                            </group>
                            <separator string="Resolution"/>
                            <field name="resolution" placeholder="Work done, parts replaced, findings..."/>
                        </page>
                        <page string="Cost" name="cost">
                            <group>
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="labour_cost" widget="monetary"/>
                                    <field name="parts_cost" widget="monetary"/>
                                    <field name="other_cost" widget="monetary"/>
                                </group>
                                <group>
                                    <field name="cost" widget="monetary" class="fs-4 fw-bold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Recurrence" name="recurrence">
                            <group>
                                <group>
                                    <field name="recurring"/>
                                    <label for="interval_number" string="Repeat Every" invisible="not recurring"/>
                                    <div class="o_row" invisible="not recurring">
                                        <field name="interval_number"/>
                                        <field name="interval_type"/>
                                    </div>
                                </group>
                                <group>
                                    <field name="next_maintenance_id" invisible="not next_maintenance_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dsl_asset_maintenance_kanban" model="ir.ui.view">
        <field name="name">dsl.asset.maintenance.kanban</field>
        <field name="model">dsl.asset.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_dsl_fa_kanban" quick_create="false" group_create="false">
                <field name="is_overdue"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="title" class="fw-bold"/>
                            <field name="priority" widget="priority"/>
                        </div>
                        <div class="text-muted small"><field name="asset_id"/></div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <field name="maintenance_type" widget="badge"/>
                            <span t-att-class="record.is_overdue.raw_value ? 'text-danger fw-bold small' : 'small'">
                                <i class="fa fa-calendar me-1" title="Scheduled"/><field name="scheduled_date"/>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <field name="responsible_user_id" widget="many2one_avatar_user"/>
                            <field name="cost" widget="monetary" class="fw-bold"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dsl_asset_maintenance_calendar" model="ir.ui.view">
        <field name="name">dsl.asset.maintenance.calendar</field>
        <field name="model">dsl.asset.maintenance</field>
        <field name="arch" type="xml">
            <calendar string="Maintenance Calendar" date_start="scheduled_date" color="maintenance_type" mode="month" quick_create="0">
                <field name="asset_id"/>
                <field name="maintenance_type" filters="1"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_dsl_asset_maintenance_pivot" model="ir.ui.view">
        <field name="name">dsl.asset.maintenance.pivot</field>
        <field name="model">dsl.asset.maintenance</field>
        <field name="arch" type="xml">
            <pivot string="Maintenance Cost Analysis" sample="1">
                <field name="maintenance_type" type="row"/>
                <field name="scheduled_date" interval="month" type="col"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dsl_asset_maintenance_graph" model="ir.ui.view">
        <field name="name">dsl.asset.maintenance.graph</field>
        <field name="model">dsl.asset.maintenance</field>
        <field name="arch" type="xml">
            <graph string="Maintenance Cost" type="bar" sample="1">
                <field name="scheduled_date" interval="month"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dsl_asset_maintenance_search" model="ir.ui.view">
        <field name="name">dsl.asset.maintenance.search</field>
        <field name="model">dsl.asset.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="asset_id"/>
                <field name="vendor_id"/>
                <field name="technician_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('draft', 'scheduled', 'in_progress'))]"/>
                <filter name="overdue" string="Overdue" domain="[('state', 'in', ('draft', 'scheduled')), ('scheduled_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="preventive" string="Preventive" domain="[('maintenance_type', '=', 'preventive')]"/>
                <filter name="corrective" string="Corrective" domain="[('maintenance_type', '=', 'corrective')]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="grp_type" string="Type" context="{'group_by': 'maintenance_type'}"/>
                    <filter name="grp_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="grp_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dsl_asset_maintenance" model="ir.actions.act_window">
        <field name="name">Asset Maintenance</field>
        <field name="res_model">dsl.asset.maintenance</field>
        <field name="view_mode">kanban,list,calendar,pivot,graph,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule your first maintenance</p>
            <p>Plan preventive maintenance, log breakdowns, track costs and downtime and bill vendors in one click.</p>
        </field>
    </record>
</odoo>

