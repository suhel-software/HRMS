<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsl_asset_location_list" model="ir.ui.view">
        <field name="name">dsl.asset.location.list</field>
        <field name="model">dsl.asset.location</field>
        <field name="arch" type="xml">
            <list string="Asset Locations">
                <field name="complete_name"/>
                <field name="code"/>
                <field name="location_type" widget="badge"/>
                <field name="manager_id" widget="many2one_avatar_employee"/>
                <field name="asset_count"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="asset_value" widget="monetary"/>
                <field name="asset_book_value" widget="monetary"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_asset_location_form" model="ir.ui.view">
        <field name="name">dsl.asset.location.form</field>
        <field name="model">dsl.asset.location</field>
        <field name="arch" type="xml">
            <form string="Asset Location">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Unit 2 - Production Floor"/></h1>
                        <h4 class="text-muted"><field name="complete_name" readonly="1"/></h4>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="location_type"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="asset_value" widget="monetary"/>
                            <field name="asset_book_value" widget="monetary"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="address" placeholder="Address / directions / remarks..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsl_asset_location_kanban" model="ir.ui.view">
        <field name="name">dsl.asset.location.kanban</field>
        <field name="model">dsl.asset.location</field>
        <field name="arch" type="xml">
            <kanban class="o_dsl_fa_kanban">
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="o_dsl_fa_icon_chip"><i class="fa fa-map-marker" title="Location"/></span>
                            <div>
                                <field name="name" class="fw-bold fs-6"/>
                                <div class="text-muted small"><field name="complete_name"/></div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-2 small">
                            <span><i class="fa fa-cubes me-1" title="Assets"/><field name="asset_count"/> assets</span>
                            <span class="fw-bold"><field name="asset_book_value" widget="monetary"/></span>
                        </div>
                        <field name="location_type" widget="badge" class="mt-2"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dsl_asset_location_search" model="ir.ui.view">
        <field name="name">dsl.asset.location.search</field>
        <field name="model">dsl.asset.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_type" string="Type" context="{'group_by': 'location_type'}"/>
                    <filter name="grp_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dsl_asset_location" model="ir.actions.act_window">
        <field name="name">Asset Locations</field>
        <field name="res_model">dsl.asset.location</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first asset location</p>
            <p>Build a hierarchy of sites, buildings, floors, rooms and warehouses to know exactly where every asset is.</p>
        </field>
    </record>
</odoo>

