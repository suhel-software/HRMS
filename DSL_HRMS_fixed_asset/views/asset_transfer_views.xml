<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsl_asset_transfer_list" model="ir.ui.view">
        <field name="name">dsl.asset.transfer.list</field>
        <field name="model">dsl.asset.transfer</field>
        <field name="arch" type="xml">
            <list string="Asset Transfers" decoration-muted="state in ('cancel', 'rejected')">
                <field name="name"/>
                <field name="transfer_date"/>
                <field name="asset_id"/>
                <field name="transfer_type" widget="badge"/>
                <field name="from_location_id" optional="show"/>
                <field name="to_location_id" optional="show"/>
                <field name="from_employee_id" optional="hide"/>
                <field name="to_employee_id" optional="show"/>
                <field name="requested_by_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'submitted'"
                       decoration-primary="state == 'approved'" decoration-success="state == 'done'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_asset_transfer_form" model="ir.ui.view">
        <field name="name">dsl.asset.transfer.form</field>
        <field name="model">dsl.asset.transfer</field>
        <field name="arch" type="xml">
            <form string="Asset Transfer">
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'submitted'" groups="DSL_HRMS_fixed_asset.group_fixed_asset_manager"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" groups="DSL_HRMS_fixed_asset.group_fixed_asset_manager"/>
                    <button name="action_done" string="Execute Transfer" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ('cancel', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <field name="asset_image" widget="image" class="oe_avatar" readonly="1"/>
                    <div class="oe_title">
                        <span class="o_form_label">Transfer No.</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="asset_code"/>
                            <field name="transfer_type" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="transfer_date" readonly="state == 'done'"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approval_date" invisible="not approval_date"/>
                        </group>
                    </group>
                    <div class="o_dsl_fa_transfer_flow row g-3 my-2">
                        <div class="col-md-6">
                            <div class="o_dsl_fa_panel o_dsl_fa_panel_from">
                                <div class="o_dsl_fa_panel_title"><i class="fa fa-sign-out me-2"/>FROM (Current)</div>
                                <group>
                                    <field name="from_location_id"/>
                                    <field name="from_department_id"/>
                                    <field name="from_employee_id"/>
                                </group>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="o_dsl_fa_panel o_dsl_fa_panel_to">
                                <div class="o_dsl_fa_panel_title"><i class="fa fa-sign-in me-2"/>TO (Destination)</div>
                                <group>
                                    <field name="to_location_id" readonly="state not in ('draft',)"/>
                                    <field name="to_department_id" readonly="state not in ('draft',)"/>
                                    <field name="to_employee_id" readonly="state not in ('draft',)"/>
                                </group>
                            </div>
                        </div>
                    </div>
                    <field name="reason" placeholder="Reason / justification for this transfer..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dsl_asset_transfer_search" model="ir.ui.view">
        <field name="name">dsl.asset.transfer.search</field>
        <field name="model">dsl.asset.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="to_employee_id"/>
                <field name="to_location_id"/>
                <filter name="to_approve" string="Waiting Approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved (To Execute)" domain="[('state', '=', 'approved')]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_type" string="Transfer Type" context="{'group_by': 'transfer_type'}"/>
                    <filter name="grp_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="grp_month" string="Month" context="{'group_by': 'transfer_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dsl_asset_transfer" model="ir.actions.act_window">
        <field name="name">Asset Transfers</field>
        <field name="res_model">dsl.asset.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an asset transfer</p>
            <p>Move assets between locations, departments, units or employees with a full approval trail.</p>
        </field>
    </record>
</odoo>

