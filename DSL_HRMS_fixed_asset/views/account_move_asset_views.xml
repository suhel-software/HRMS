<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Journal Items list: "Create Asset" header button -->
    <record id="view_move_line_tree_create_asset" model="ir.ui.view">
        <field name="name">account.move.line.list.create.asset</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="DSL_HRMS_accounting.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="turn_as_asset" type="object" string="Create Asset" groups="account.group_account_user" data-hotkey="c"/>
            </xpath>
        </field>
    </record>

    <!-- Journal Entry form: asset smart buttons & asset move type -->
    <record id="view_move_form_asset_inherit" model="ir.ui.view">
        <field name="name">account.move.form.asset</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="asset_id" invisible="1"/>
                <field name="asset_ids" invisible="1"/>
                <field name="count_asset" invisible="1"/>
                <field name="draft_asset_exists" invisible="1"/>
                <button name="open_asset_view" invisible="not asset_id" class="oe_stat_button" icon="fa-cube" type="object">
                    <field name="asset_id_display_name" nolabel="1"/>
                </button>
                <button name="action_open_asset_ids" type="object" class="oe_stat_button" icon="fa-id-card-o"
                        invisible="count_asset == 0 or draft_asset_exists">
                    <field string="Asset(s)" name="count_asset" widget="statinfo"/>
                </button>
                <button name="action_open_asset_ids" type="object" class="oe_stat_button text-danger" icon="fa-id-card-o"
                        invisible="count_asset == 0 or not draft_asset_exists">
                    <field string="Asset(s)" name="count_asset" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//page[@id='other_tab']//group[@name='accounting_info_group']" position="inside">
                <field name="asset_move_type" invisible="not asset_id and not asset_ids" readonly="0"/>
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//group[@id='other_tab_entry_group']//group[@name='misc_group']" position="inside">
                <field name="asset_move_type" invisible="not asset_id and not asset_ids" readonly="0"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_form_asset_inherit" model="ir.ui.view">
        <field name="name">account.move.line.form.asset</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="move_id" position="after">
                <group string="Related Assets" invisible="not asset_ids">
                    <field name="asset_ids" nolabel="1"/>
                </group>
            </field>
        </field>
    </record>

    <record model="ir.actions.server" id="action_account_aml_to_asset">
        <field name="name">Create Asset</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.turn_as_asset()
        </field>
    </record>

    <!-- Chart of Accounts: asset automation -->
    <record id="view_account_form_asset_inherit" model="ir.ui.view">
        <field name="name">account.account.form.asset</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="after">
                <page string="Asset Automation" name="page_automation" invisible="not can_create_asset">
                    <group>
                        <group>
                            <field name="can_create_asset" invisible="1"/>
                            <field name="form_view_ref" invisible="1"/>
                            <field name="create_asset" string="Automate Asset" widget="radio"/>
                            <field name="multiple_assets_per_line" string="Manage Items"
                                   invisible="create_asset == 'no'"/>
                            <field name="asset_model_ids"
                                   widget="many2many_tags"
                                   domain="[('state', '=', 'model')]"
                                   invisible="context.get('hide_model_on_account') or create_asset == 'no'"
                                   required="create_asset == 'validate' and can_create_asset"
                                   context="{'default_state': 'model', 'form_view_ref': form_view_ref, 'default_account_depreciation_id': id}"
                                   string="Asset Model"
                                   options="{'no_quick_create': True}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Company settings: gain / loss accounts for asset sale -->
    <record id="view_company_form_asset_accounts" model="ir.ui.view">
        <field name="name">res.company.form.asset.accounts</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Fixed Assets" name="dsl_fixed_asset_accounts" groups="account.group_account_manager">
                    <group string="Asset Sale / Disposal Accounts">
                        <field name="gain_account_id"/>
                        <field name="loss_account_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

