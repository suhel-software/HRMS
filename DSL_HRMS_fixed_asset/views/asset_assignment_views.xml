<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsl_asset_assignment_list" model="ir.ui.view">
        <field name="name">dsl.asset.assignment.list</field>
        <field name="model">dsl.asset.assignment</field>
        <field name="arch" type="xml">
            <list string="Asset Custody" decoration-muted="state in ('returned', 'cancel')" decoration-danger="is_overdue">
                <field name="is_overdue" column_invisible="True"/>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id"/>
                <field name="location_id" optional="show"/>
                <field name="date_assigned"/>
                <field name="expected_return_date" optional="show"/>
                <field name="date_returned" optional="show"/>
                <field name="condition_out" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'assigned'"
                       decoration-muted="state in ('returned', 'cancel')"/>
            </list>
        </field>
    </record>

    <record id="view_dsl_asset_assignment_form" model="ir.ui.view">
        <field name="name">dsl.asset.assignment.form</field>
        <field name="model">dsl.asset.assignment</field>
        <field name="arch" type="xml">
            <form string="Asset Custody / Handover">
                <header>
                    <button name="action_assign" string="Confirm Handover" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_return" string="Receive Back (Return)" type="object" class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_print_handover" string="Print Handover Form" type="object" icon="fa-print" invisible="state == 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft',)"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,returned"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <field name="is_overdue" invisible="1"/>
                    <field name="asset_image" widget="image" class="oe_avatar" readonly="1"/>
                    <div class="oe_title">
                        <span class="o_form_label">Handover Reference</span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Asset">
                            <field name="asset_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="asset_code"/>
                            <field name="condition_out" readonly="state != 'draft'"/>
                            <field name="condition_in" invisible="state == 'draft'" readonly="state == 'returned'"/>
                        </group>
                        <group string="Custodian">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="location_id" readonly="state != 'draft'"/>
                            <field name="handover_by_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Dates">
                            <field name="date_assigned" readonly="state != 'draft'"/>
                            <field name="expected_return_date"/>
                            <field name="date_returned"/>
                        </group>
                        <group string="Purpose">
                            <field name="purpose"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Accessories handed over, remarks..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dsl_asset_assignment_search" model="ir.ui.view">
        <field name="name">dsl.asset.assignment.search</field>
        <field name="model">dsl.asset.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="active_custody" string="Currently Assigned" domain="[('state', '=', 'assigned')]"/>
                <filter name="returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <filter name="overdue" string="Overdue Return" domain="[('state', '=', 'assigned'), ('expected_return_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_emp" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="grp_dept" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="grp_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dsl_asset_assignment" model="ir.actions.act_window">
        <field name="name">Asset Custody &amp; Handover</field>
        <field name="res_model">dsl.asset.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_custody': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hand over an asset to an employee</p>
            <p>Track who holds which company asset, since when, and in what condition it was returned.</p>
        </field>
    </record>
</odoo>

