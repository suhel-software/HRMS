<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_dsl_pf_policy_company" model="ir.rule">
            <field name="name">DSL PF Policy: Multi-Company</field>
            <field name="model_id" ref="model_dsl_pf_policy"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_dsl_pf_account_branch_isolation" model="ir.rule">
            <field name="name">DSL PF Account: Company &amp; Branch Isolation</field>
            <field name="model_id" ref="model_dsl_pf_account"/>
            <field name="domain_force">(['&amp;', ('company_id', 'in', company_ids), '|', ('branch_id', '=', False), ('branch_id', 'in', dsl_branch_ids)] if dsl_is_mother_user else [('company_id', 'in', company_ids), ('branch_id', 'in', dsl_branch_ids)]) if dsl_strict_branch else [('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_dsl_pf_profit_company" model="ir.rule">
            <field name="name">DSL PF Profit Batch: Multi-Company</field>
            <field name="model_id" ref="model_dsl_pf_profit_distribution"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>

